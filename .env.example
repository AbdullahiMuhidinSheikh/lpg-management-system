# Fill in your real Supabase connection strings below.
#
# 1. Go to https://supabase.com/dashboard/project/_?showConnect=true
# 2. Find your Supavisor Session Mode pooler string (port 5432)
# 3. Find your Direct Connection string
# 4. Replace [YOUR-PASSWORD] with the password of your "prisma" DB user
#
# DATABASE_URL  = Supavisor Session pooler (used at runtime by the app)
# DIRECT_URL    = Direct connection (used by Prisma Migrate only)


# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.projectid:pass@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.projectid:pass@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"


# Optional: Only needed if you use the Supabase JS client SDK
NEXT_PUBLIC_SUPABASE_URL=https://id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Backend URL (Python Flask server, optional)
AI_BACKEND_URL=http://localhost:5000
