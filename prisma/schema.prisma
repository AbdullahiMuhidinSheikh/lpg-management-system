generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Product {
  id        Int         @id @default(autoincrement())
  name      String
  type      String
  createdAt DateTime     @default(now())
  // relation fields
  cylinderSizes CylinderSize[]
  hardwareSerials HardwareSerial[]
}

model CylinderSize {
  id             Int           @id @default(autoincrement())
  label          String
  kg             Int
  isPlastic      Boolean       @default(false)
  product        Product?      @relation(fields:[productId], references:[id])
  productId      Int?
  inventory      Inventory?
  cylinderDebts  CylinderDebt[]
  purchases      Purchase[]
  sales          Sale[]
}

model Inventory {
  id             Int           @id @default(autoincrement())
  cylinderSize   CylinderSize  @relation(fields:[cylinderSizeId], references:[id])
  cylinderSizeId Int           @unique
  fullStock      Int           @default(0)
  emptyStock     Int           @default(0)
  updatedAt      DateTime      @updatedAt
}

model Client {
  id                  Int              @id @default(autoincrement())
  name                String
  type                String           @default("RETAIL")
  creditLimitAmount   Float?           // monetary credit limit in KES
  creditLimitCylinders Int?            // cylinder count limit
  createdAt           DateTime         @default(now())
  cylinderDebts       CylinderDebt[]
  sales               Sale[]
  hardwareSerials     HardwareSerial[]
}

model CylinderDebt {
  id              Int          @id @default(autoincrement())
  client          Client       @relation(fields:[clientId], references:[id])
  clientId        Int
  cylinderSize    CylinderSize @relation(fields:[cylinderSizeId], references:[id])
  cylinderSizeId  Int
  issuedFull      Int          @default(0)
  returnedEmpty   Int          @default(0)
  // computed debt = issuedFull - returnedEmpty
  createdAt       DateTime     @default(now())

  @@unique([clientId, cylinderSizeId], name: "client_id_cylinderSizeId")
}

model RatePerKg {
  id           Int      @id @default(autoincrement())
  rate         Float
  effectiveAt  DateTime @default(now())
  note         String?
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  purchases Purchase[]
}

model Purchase {
  id              Int          @id @default(autoincrement())
  supplier        Supplier     @relation(fields:[supplierId], references:[id])
  supplierId      Int
  cylinderSize    CylinderSize @relation(fields:[cylinderSizeId], references:[id])
  cylinderSizeId  Int
  quantity        Int
  pricePerKg      Float
  total           Float
  createdAt       DateTime     @default(now())
}

model Sale {
  id              Int          @id @default(autoincrement())
  client          Client?      @relation(fields:[clientId], references:[id])
  clientId        Int?
  clientName      String?
  cylinderSize    CylinderSize? @relation(fields:[cylinderSizeId], references:[id])
  cylinderSizeId  Int?
  quantity        Int
  deliveryType    String
  paymentStatus   String
  ratePerKg       Float
  total           Float
  user            User?        @relation(fields:[userId], references:[id])
  userId          String?
  note            String?
  createdAt       DateTime     @default(now())
}

model Expense {
  id        Int         @id @default(autoincrement())
  type      String
  amount    Float
  note      String?
  createdAt DateTime    @default(now())
}

model HardwareSerial {
  id         Int            @id @default(autoincrement())
  serial     String         @unique
  product    Product        @relation(fields:[productId], references:[id])
  productId  Int
  status     String         @default("IN_STOCK")
  client     Client?        @relation(fields:[clientId], references:[id])
  clientId   Int?
  createdAt  DateTime       @default(now())
}
